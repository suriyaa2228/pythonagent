# ==============================================================================
# Playwright Agent AI Platform Environment Template (.env.example)
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENV=stage

# LLM & AI Generation API Configuration
# Enter your Groq API key to use live LLM code generation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES=2

# RAG & Embedding API Configuration
# Enter your Mistral API key to use live vector embeddings
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Target Test Environments Credentials (Momentec Brands)
STAGE_URL=https://stage.momentecbrands.com/
STAGE_USERNAME=your_stage_username_here
STAGE_PASSWORD=your_stage_password_here

PROD_URL=https://www.momentecbrands.com/
PROD_USERNAME=SURIYAA
PROD_PASSWORD=your_prod_password_here

DEV_URL=https://dev.momentecbrands.com/
DEV_USERNAME=SURIYAA
DEV_PASSWORD=your_dev_password_here

# Test Execution Defaults
DEFAULT_HEADLESS=false
DEFAULT_TIMEOUT=30000
